{
  "openapi": "3.0.3",
  "info": {
    "title": "MiniShop v1.0 API",
    "version": "1.0.0",
    "description": "Personal testing practice project. Not a commercial contract."
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "password"],
                "properties": {
                  "phone": {"type": "string"},
                  "password": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "OK with token; no order status field"},
          "401": {"description": "Bad password"}
        }
      }
    },
    "/api/register": {
      "post": {
        "summary": "Register; does not issue token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "password"],
                "properties": {
                  "phone": {"type": "string"},
                  "password": {"type": "string"},
                  "display_name": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Created; body has result and phone, no token"},
          "400": {"description": "Invalid phone or password"},
          "409": {"description": "Phone taken"}
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "List products",
        "parameters": [
          {"name": "keyword", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "items array"}
        }
      }
    },
    "/api/cart": {
      "get": {
        "summary": "Current user cart",
        "responses": {
          "200": {"description": "items"},
          "401": {"description": "Unauthorized"}
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "summary": "Set cart qty",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sku", "qty"],
                "properties": {
                  "sku": {"type": "string"},
                  "qty": {"type": "integer"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Updated"},
          "400": {"description": "Rule or type error"},
          "401": {"description": "Unauthorized"}
        }
      }
    },
    "/api/orders": {
      "post": {
        "summary": "Create order; not idempotent; body has id only",
        "responses": {
          "201": {"description": "Created id"},
          "400": {"description": "Rule error"},
          "401": {"description": "Unauthorized"}
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Get own order",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "id and items, no status"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Forbidden"},
          "404": {"description": "Not found"}
        }
      }
    },
    "/api/admin/products": {
      "get": {
        "summary": "Admin stock list",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Forbidden"}
        }
      }
    },
    "/api/admin/orders": {
      "get": {
        "summary": "Admin order ids only",
        "responses": {
          "200": {"description": "ids"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Forbidden"}
        }
      }
    }
  }
}
